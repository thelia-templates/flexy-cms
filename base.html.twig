{% set breadcrumb = SEOneBreadcrumb() %}
<!DOCTYPE html>
<html lang="{{ lang_code }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1"/>

        {{ theme_hook('layout.head.top', {
            breadcrumb,
            title:       block('title') is defined ? block('title')|trim : null,
            description: block('meta_desc') is defined ? block('meta_desc')|trim : null,
            og_type:     block('og_type') is defined ? block('og_type')|trim : null,
        }) }}

        {% block robots %}{% endblock %}

        {# The icon uploaded in Configuration > Store, when there is one, so a
           client changes it without touching the theme. #}
        {% set site_icon = cms_site_icon() %}
        {% if site_icon %}
            <link rel="icon" href="{{ site_icon }}"/>
            <link rel="apple-touch-icon" href="{{ site_icon }}"/>
        {% else %}
            <link rel="icon" type="image/png" href="{{ asset('favicons/favicon-96x96.png') }}" sizes="96x96"/>
            <link rel="icon" type="image/svg+xml" href="{{ asset('favicons/favicon.svg') }}"/>
            <link rel="shortcut icon" href="{{ asset('favicons/favicon.ico') }}"/>
            <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('favicons/apple-touch-icon.png') }}"/>
        {% endif %}
        <link rel="manifest" href="{{ asset('favicons/site.webmanifest') }}"/>

        {# The two faces every page starts with, fetched alongside the
           stylesheet instead of after it. The rest of the family follows from
           fonts.css, which is served by this site: asking Google for them would
           hand the address of every visitor to a third party before they have
           agreed to anything. #}
        <link rel="preload" as="font" type="font/woff2" href="{{ asset('fonts/poppins-400-normal-latin.woff2') }}" crossorigin>
        <link rel="preload" as="font" type="font/woff2" href="{{ asset('fonts/poppins-600-normal-latin.woff2') }}" crossorigin>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}" blocking="render">
        {% endblock %}


        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {{ theme_hook('layout.head.bottom', {breadcrumb}) }}
        {% block structured_data %}{% endblock %}
    </head>

    <body class="no-js {% block body_class %}{% endblock %}">

        {# First thing in the tab order: somebody navigating with a keyboard
           reaches the content without walking through the whole menu. It is
           off-screen until focused. #}
        <a class="skip-link" href="#main-content">{{ 'Skip to content'|trans }}</a>

        {{ theme_hook('layout.body.top') }}
        {% block header %}
            <twig:Layouts:Header:Base />
        {% endblock %}
        {{ theme_hook('layout.header.bottom') }}

        <main id="main-content" tabindex="-1" {% block stimulus_controller %}{% endblock %}>
            {% block body %}{% endblock %}
        </main>

        {{ theme_hook('layout.footer.top') }}
        {% block footer %}
            <twig:Layouts:Footer:Base />
        {% endblock %}

        {% block modals %}{% endblock %}
        {{ theme_hook('layout.body.bottom') }}
    </body>
</html>
