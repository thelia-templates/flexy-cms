{# Controller identifier shared by HeaderNav/LangSelect/HeaderMenuItem — must match if renamed. #}
{% set headerController = 'Layouts--Header--base' %}

<header
    class="{{ ('Header ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        ...stimulus_controller(headerController)|stimulus_controller('sticky-observer'),
    }).without('class') }}
>
    <div class="Header-top">
        <div class="flex">
            <div class="flex items-center self-center h-full">
                <a href="/" class="Header-logo">
                    {{ ux_icon('thelia') }}
                </a>
            </div>
        </div>

        {# Named, because a page has more than one nav and a screen reader
           announces them by their label. #}
        <nav id="Menu" class="Header-menu" aria-label="{{ 'Main menu'|trans }}" {{ stimulus_target(headerController, 'panel') }} data-header-panel-id="menu">
            <twig:Molecules:Button:Base
                icon_left="chevron-left"
                size="small"
                color="minimal"
                data-menu-back="-1"
                {{...stimulus_target(headerController, 'back')}}
                {{...stimulus_action(headerController, 'back')}}
            >
                {{ 'Menu'|trans }}
            </twig:Molecules:Button:Base>
            <button type="button" data-menu-close {{ stimulus_action(headerController, 'close') }}>
                {{ ux_icon('close') }}
            </button>
            <ul class="Header-navigation" data-menu-sub="0">
                {% for item in menuItems %}
                    {% if item.type == 'folder' %}
                        <twig:Organisms:HeaderMenuItem:Folder
                            id="{{ item.id }}"
                            title="{{ item.title }}"
                            href="{{ item.href }}"
                            :includeContents="item.includeContents"
                        />
                    {% elseif item.type == 'link' %}
                        <twig:Organisms:HeaderMenuItem:Base
                            id="{{ item.id }}"
                            title="{{ item.title }}"
                            href="{{ item.href }}"
                        />
                    {% else %}
                        <twig:Organisms:HeaderMenuItem:Category
                            id="{{ item.id }}"
                            title="{{ item.title }}"
                            href="{{ item.href }}"
                        />
                    {% endif %}
                {% endfor %}
            </ul>
        </nav>

        <twig:Organisms:HeaderNav:Base />
    </div>
</header>
