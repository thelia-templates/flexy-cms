{# Must match the controller identifier declared in Layouts/Header/Base.html.twig. #}
{% set headerController = 'Layouts--Header--base' %}

{% set currentLang = this.currentLang %}
{% if currentLang %}
    {% set langs = this.langs %}

    {# Where the page being read lives in each language. Switching language has
       to keep the visitor on their page: sending them to the home page loses it.
       A language the page has no version in keeps the home page as its target,
       which is a fallback, not a destination we advertise to crawlers. #}
    {% set alternates = {} %}
    {% for alternate in cms_page_alternates() %}
        {% set alternates = alternates|merge({ (alternate.locale): alternate.url }) %}
    {% endfor %}
    {# `url_site` is empty on a shop that never set it: '/' keeps the fallback
       from turning into a link to the current page in a language it has no
       version in. #}
    {% set homeOf = attr('config', 'url_site')|default('') ?: '/' %}

    <div
        class="{{ ('LangSelect ' ~ attributes.render('class'))|tailwind_merge }}"
        {{ attributes.defaults({...stimulus_controller('Organisms--LangSelect--base')}).without('class') }}
    >
        <button
            type="button"
            class="LangSelect-current"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="LangSelect-list"
            {{ stimulus_action('Organisms--LangSelect--base', 'toggle', 'click') }}
            {{ stimulus_target('Organisms--LangSelect--base', 'toggler') }}
        >
            {{ ux_icon('flags:' ~ currentLang.code, { class: 'LangSelect-flag' }) }}
            {{ currentLang.code }}
            {{ ux_icon('chevron-small-down', { class: 'w-6 h-6' }) }}
        </button>
        {% if langs|length %}
            <ul class="LangSelect-list" id="LangSelect-list">
                {% for lang in langs %}
                    <li>
                        <a
                            href="{{ alternates[lang.locale]|default(homeOf ~ '?' ~ { lang: lang.locale }|url_encode) }}"
                            class="LangSelect-lang{% if currentLang.code == lang.code %} active{% endif %}"
                        >
                            {{ ux_icon('flags:' ~ lang.code, { class: 'LangSelect-flag' }) }}
                            <span>{{ lang.title }}</span>
                            {% if currentLang.code == lang.code %}
                                {{ ux_icon('checkmark', { class: 'LangSelect-check' }) }}
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <twig:Molecules:HeaderButton:Base
        icon="{{ 'flags:' ~ currentLang.code }}"
        color="light"
        small="true"
        text="{{ currentLang.title }}"
        class="md:hidden"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="lang-panel"
        {{...stimulus_action(headerController, 'togglePanel', 'click', {panel: 'lang'})}}
    />

    <div class="MobilePanel" id="lang-panel" {{ stimulus_target(headerController, 'panel') }} data-header-panel-id="lang">
        <button type="button" {{ stimulus_action(headerController, 'close') }}>
            {{ ux_icon('close') }}
        </button>
        <p class="h3 mb-7">{{ 'Language'|trans }}</p>
        {% if langs|length %}
            <ul class="LangSelect-mobileList">
                {% for lang in langs %}
                    <li>
                        <a
                            href="{{ alternates[lang.locale]|default(homeOf ~ '?' ~ { lang: lang.locale }|url_encode) }}"
                            class="LangSelect-mobileItem{% if currentLang.code == lang.code %} active{% endif %}"
                        >
                            {{ ux_icon('flags:' ~ lang.code, { class: 'LangSelect-flag' }) }}
                            <span>{{ lang.title }}</span>
                            {% if currentLang.code == lang.code %}
                                {{ ux_icon('checkmark', { class: 'LangSelect-check' }) }}
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endif %}
