<?xml version="1.0"?>
<!--
generated on : {{ "now"|date("Y-m-d H:i:s") }}
{% if _lang_ is defined and _lang_ != "" %}lang : {{ _lang_ }}{% endif %}
{% if _context_ is defined and _context_ != "" %}context : {{ _context_ }}{% endif %}
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
    <url>
        <loc>{{ absolute_url(path('index')) }}</loc>
    </url>
    {% set allLanguages = resources('/api/front/languages', {'active': 1}) %}
    {% set languages = (_lang_ is defined and _lang_ != '')
        ? allLanguages|filter(l => l.code == _lang_ or l.locale == _lang_)
        : allLanguages
    %}
    {% set context = _context_ is defined ? _context_ : '' %}

    {# ==== CATALOG ==== #}
    {% if context == '' or context == 'catalog' %}
        {# Categories #}
        {% set categories = resources('/api/front/categories', {'visible' : 1}) %}
        {% for lang in languages %}
            {% set locale = lang.locale ?? lang.code ?? 'fr_FR' %}
            {% for category in categories %}
                {% set loc = category.publicUrl ?? '' %}
                {% if loc %}
                    <url>
                        <loc>{{ absolute_url(loc) }}</loc>
                        {% if category.updatedAt is defined and category.updatedAt %}
                            <lastmod>{{ category.updatedAt|date('c') }}</lastmod>
                        {% elseif category.createdAt is defined and category.createdAt %}
                            <lastmod>{{ category.createdAt|date('c') }}</lastmod>
                        {% endif %}
                    </url>
                {% endif %}
            {% endfor %}
        {% endfor %}

        {# Products #}
        {% set products = resources('/api/front/products', {'visible' : 1}) %}
        {% for lang in languages %}
            {% set locale = lang.locale ?? lang.code ?? 'fr_FR' %}
            {% for product in products %}
                {% set loc = product.publicUrl ?? '' %}
                {% if loc %}
                    <url>
                        <loc>{{ absolute_url(loc) }}</loc>
                        {% if product.updatedAt is defined and product.updatedAt %}
                            <lastmod>{{ product.updatedAt|date('c') }}</lastmod>
                        {% elseif product.createdAt is defined and product.createdAt %}
                            <lastmod>{{ product.createdAt|date('c') }}</lastmod>
                        {% endif %}
                    </url>
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}

    {# ==== CONTENT ==== #}
    {% if context == '' or context == 'content' %}
        {# Folders #}
        {% set folders = resources('/api/front/folders', {'visible' : 1}) %}
        {% for lang in languages %}
            {% set locale = lang.locale ?? lang.code ?? 'fr_FR' %}
            {% for folder in folders %}
                {% set loc = folder.publicUrl ?? '' %}
                {% if loc %}
                    <url>
                        <loc>{{ absolute_url(loc) }}</loc>
                        {% if folder.updatedAt is defined and folder.updatedAt %}
                            <lastmod>{{ folder.updatedAt|date('c') }}</lastmod>
                        {% elseif folder.createdAt is defined and folder.createdAt %}
                            <lastmod>{{ folder.createdAt|date('c') }}</lastmod>
                        {% endif %}
                    </url>
                {% endif %}
            {% endfor %}
        {% endfor %}

        {# Contents #}
        {% set contents = resources('/api/front/contents', {'visible' : 1}) %}
        {% for lang in languages %}
            {% set locale = lang.locale ?? lang.code ?? 'fr_FR' %}
            {% for content in contents %}
                {% set loc = content.publicUrl ?? '' %}
                {% if loc %}
                    <url>
                        <loc>{{ absolute_url(loc) }}</loc>
                        {% if content.updatedAt is defined and content.updatedAt %}
                            <lastmod>{{ content.updatedAt|date('c') }}</lastmod>
                        {% elseif content.createdAt is defined and content.createdAt %}
                            <lastmod>{{ content.createdAt|date('c') }}</lastmod>
                        {% endif %}
                    </url>
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}

    {# Anything a module wants in the sitemap. It receives the language and the
       context asked for, so a module can answer for one and keep quiet for the
       others. #}
    {{ theme_hook('sitemap.urls', { lang: _lang_|default(''), context: context }) }}
</urlset>
