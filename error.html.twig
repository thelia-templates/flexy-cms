{% extends 'base.html.twig' %}

{% block title %}{{ status_code }} - {{ 'Error'|trans }}{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div class="container-m flex flex-1 flex-col gap-8 items-center justify-center text-center">
        <div class="w-3/5 h-auto">
            {% block error_image %}
                {{ source('assets/images/volcano.svg') }}
            {% endblock %}
        </div>
        <div class="flex flex-col gap-2 items-center">
            {# An `h1`, styled as an h3: a page with no first-level heading is a
               page a screen reader cannot summarise, and the error pages were
               the only ones without one. #}
            {% block error_content %}
                <h1 class="h3">{{ status_code }}</h1>
                <p class="paragraph-2">{{ exception_message }}</p>
            {% endblock %}
        </div>

        <twig:Molecules:Button:Base
            text="{{ 'Homepage'|trans }}"
            size="large"
            href="/"
            icon_left="chevron-left"
        />
    </div>
{% endblock %}

{% block footer %}{% endblock %}
